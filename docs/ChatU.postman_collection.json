    {
      "name": "Caso 01 - Salud del servidor",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Inicio de cada ejecución: sufijo único y sin valores de ejecuciones anteriores.",
                  "pm.collectionVariables.set('runId', String(Date.now()));",
                  "['userId', 'betoId', 'roomId', 'messageId', 'createdMessages'].forEach((key) => pm.collectionVariables.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Formato de éxito', () => pm.expect(body.ok).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    },
