    {
      "name": "Caso 07 - Enviar 25 mensajes y paginar",
      "item": [
        {
          "name": "GET /rooms/:id/messages?page=2&limit=20",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Crea los 25 mensajes uno detrás de otro antes de pedir la página 2.",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "const roomId = pm.collectionVariables.get('roomId');",
                  "const senders = [pm.collectionVariables.get('userId'), pm.collectionVariables.get('betoId')];",
                  "const TOTAL = 25;",
                  "let created = 0;",
                  "",
                  "const send = (n) => {",
                  "  if (n > TOTAL) {",
                  "    pm.collectionVariables.set('createdMessages', String(created));",
                  "    return;",
                  "  }",
                  "  pm.sendRequest({",
                  "    url: baseUrl + '/rooms/' + roomId + '/messages',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ senderId: senders[(n - 1) % 2], content: 'Mensaje ' + n }) }",
                  "  }, (err, res) => {",
                  "    if (!err && res.code === 201) {",
                  "      created += 1;",
                  "      if (n === 1) pm.collectionVariables.set('messageId', res.json().data._id);",
                  "    }",
                  "    send(n + 1);",
                  "  });",
                  "};",
                  "",
                  "send(1);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Se crearon los 25 mensajes', () => pm.expect(pm.collectionVariables.get('createdMessages')).to.eql('25'));",
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Formato de éxito', () => pm.expect(body.ok).to.eql(true));",
                  "pm.test('La página 2 trae 5 mensajes de un total de 25', () => {",
                  "  pm.expect(body.data).to.have.lengthOf(5);",
                  "  pm.expect(body.meta).to.eql({ page: 2, limit: 20, total: 25 });",
                  "});",
                  "pm.test('Los más recientes van primero', () => {",
                  "  pm.expect(body.data.map((m) => m.content)).to.eql(['Mensaje 5', 'Mensaje 4', 'Mensaje 3', 'Mensaje 2', 'Mensaje 1']);",
                  "});",
                  "pm.test('El sender viene poblado solo con username y avatarUrl', () => {",
                  "  pm.expect(body.data[0].sender.username).to.be.a('string');",
                  "  pm.expect(body.data[0].sender).to.have.property('avatarUrl');",
                  "  pm.expect(body.data[0].sender).to.not.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms/{{roomId}}/messages?page=2&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms",
                "{{roomId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        }
      ]
